{
  "name": "homify-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "ios:hot": "./scripts/ios-hot-refresh.sh",
    "prebuild": "expo prebuild --no-install",
    "pod:update": "cd ios && pod install --repo-update",
    "dev:ios": "export USE_CCACHE=1 && npx expo run:ios --port 8085",
    "dev:android": "npx expo run:android --port 8086",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "clean:android:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-android.ps1",
    "clean:android": "bash ./scripts/clean-android.sh",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "android:debug:clean": "cd android && gradlew.bat clean assembleDebug",
    "android:release:clean": "cd android && gradlew.bat clean assembleRelease"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@react-navigation/native": "^7.0.0",
    "@rn-primitives/avatar": "~1.2.0",
    "@rn-primitives/label": "^1.2.0",
    "@rn-primitives/portal": "~1.3.0",
    "@rn-primitives/progress": "~1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/tooltip": "~1.2.0",
    "@tanstack/react-query": "^5.81.5",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "expo-linking": "~7.1.5",
    "expo-navigation-bar": "~4.2.6",
    "expo-router": "~5.1.1",
    "expo-secure-store": "^15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.9",
    "lucide-react-native": "^0.511.0",
    "nativewind": "4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "react-native": "^0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.68",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.21.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native-community/cli": "^20.0.2",
    "@react-native/metro-config": "^0.81.1",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^54.0.25",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-native-codegen": "^0.70.7",
    "react-native-worklets": "^0.5.1",
    "typescript": "~5.9.2"
  },
  "resolutions": {
    "lightningcss": "1.27.0"
  },
  "private": true
}
